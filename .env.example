# =============================================================================
# Oceans Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env (local) or set these in your Railway project.
# Every API key is OPTIONAL — the app degrades gracefully when a key is absent.
# Add the keys you have; the matching feature lights up automatically.
# =============================================================================

# ---- Database (REQUIRED for production) ----
# Neon Postgres connection string. Local dev can use SQLite (file:./db/custom.db).
DATABASE_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/oceans?sslmode=require"

# ---- LLM (REQUIRED for all AI features) ----
# Powers: JD parsing, semantic matching, findDecisionMaker, findReferrers,
# redacted profile generation, job categorization, outreach drafting.
# Get a key at https://z.ai. Without this, AI features return a 503 "not configured".
# Two ways to provide it — the SDK reads .z-ai-config, but this env approach is cleaner:
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# GLM model for all AI calls. The API rejects requests without a model.
# glm-4.6 (default, cheap) · glm-5.2 (flagship). Must be a name the API accepts.
ZAI_MODEL="glm-4.6"

# ---- Encryption key for stored integration API keys (REQUIRED for production) ----
# 32+ random chars. Used to AES-256-GCM encrypt keys entered in the Integrations UI.
# Generate one: openssl rand -base64 48
INTEGRATION_ENCRYPTION_KEY=""

# ---- Apify (job scraping — LinkedIn/Indeed/Wellfound) ----
# Get a token at https://console.apify.com/account/integrations
# When set: ICP scrapes pull REAL LinkedIn jobs via Apify actors.
APIFY_API_KEY=""

# ---- Slack (notifications + approvals) ----
# Create a Slack app at https://api.slack.com/apps → "From scratch"
#   Bot token scopes: chat:write, chat:write.public, chat:customize
#   Enable Interactivity (Request URL = https://<your-domain>/api/slack/interactive)
# SLACK_BOT_TOKEN starts with xoxb- ; SLACK_SIGNING_SECRET is the app's signing secret.
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# Channel to post opportunity notifications to (e.g. #oceans-deals or a channel id)
SLACK_CHANNEL="#oceans-deals"

# ---- Instantly (cold-email sequencing) ----
# Get a key at https://app.instantly.ai → Settings → API
# The campaign leads get pushed into (create one in Instantly first, then paste its id).
INSTANTLY_API_KEY=""
INSTANTLY_CAMPAIGN_ID=""

# ---- HubSpot (CRM + email send to prospects) ----
# Private app token at https://app.hubspot.com/developer-settings/ (scopes: contacts, sales-email-scope)
# When set: step 9 sends the prospect email via HubSpot instead of drafting in-app.
HUBSPOT_ACCESS_TOKEN=""

# ---- Cron secret (REQUIRED for the scheduled job recheck) ----
# The daily recheck is what makes the whole aging signal work: it re-visits each
# live posting, advances lastSeenAt/timesSeen, and moves jobs through the age
# bands (24h → 1w → 1m → 3m → STUCK). Without it every job stays "fresh" forever.
# Generate one: openssl rand -hex 32
# The scheduler calls: GET /api/cron/recheck  with  Authorization: Bearer $CRON_SECRET
# If this is unset the cron endpoint refuses to run (503) rather than opening up.
CRON_SECRET=""

# ---- Seed endpoint (TEMPORARY — for initial DB seeding only) ----
# Set to "true" ONLY to run POST /api/seed once, then set back to "false".
# When false/absent in production, the seed endpoint is locked (403).
ENABLE_SEED_ENDPOINT="false"
